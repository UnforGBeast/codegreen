{
  "name": "freshwater-widget",
  "version": "1.0.0",
  "description": "Floating 8-bit lake widget that turns local AI coding token logs into an estimated freshwater figure.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "keywords": [],
  "author": "UnforGBeast <atahusain123@gmail.com>",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.freshwater.widget",
    "productName": "Freshwater",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "UnforGBeast <atahusain123@gmail.com>"
    }
  },
  "homepage": "https://github.com/UnforGBeast/codegreen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnforGBeast/codegreen.git"
  },
  "engines": {
    "node": ">=22"
  }
}
